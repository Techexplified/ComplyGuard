generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Shop {
  id              String    @id
  shopDomain      String    @unique
  accessToken     String
  complianceScore Int       @default(0)
  lastScannedAt   DateTime?
  onBoarding      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  issues          Issue[]
  scans           Scan[]
}

model Scan {
  id             String   @id @default(cuid())
  shopId         String
  score          Int
  totalChecks    Int
  passedChecks   Int
  failedChecks   Int
  categoryScores Json
  createdAt      DateTime @default(now())
  shop           Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model Issue {
  id          String   @id @default(cuid())
  shopId      String
  category    String
  severity    String
  ruleCode    String
  title       String
  description String
  resourceId  String?
  fixGuide    String
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
}
